{
  "Comment": "State machine para procesar batches de logs y separar alertas sospechosas en DynamoDB",
  "StartAt": "ParseBatch",
  "States": {
    "ParseBatch": {
      "Type": "Task",
      "Resource": "${PARSE_BATCH_LAMBDA_ARN}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "ProcessLogLines"
    },
    "ProcessLogLines": {
      "Type": "Map",
      "MaxConcurrency": 10,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "ClassifyLine",
        "States": {
          "ClassifyLine": {
            "Type": "Choice",
            "Comment": "Clasifica la línea: sospechosa si contiene POSSIBLE BREAK-IN ATTEMPT o Invalid user",
            "Choices": [
              {
                "Variable": "$.message",
                "StringMatches": "*POSSIBLE BREAK-IN ATTEMPT*",
                "Next": "MarkBreakInAttempt"
              },
              {
                "Variable": "$.message",
                "StringMatches": "*Invalid user*",
                "Next": "MarkInvalidUser"
              }
            ],
            "Default": "MarkNormal"
          },
          "MarkBreakInAttempt": {
            "Type": "Pass",
            "Result": {
              "label": "suspicious",
              "severity": "HIGH"
            },
            "ResultPath": "$.classification",
            "Next": "RouteByClassification"
          },
          "MarkInvalidUser": {
            "Type": "Pass",
            "Result": {
              "label": "suspicious",
              "severity": "MEDIUM"
            },
            "ResultPath": "$.classification",
            "Next": "RouteByClassification"
          },
          "MarkNormal": {
            "Type": "Pass",
            "Result": {
              "label": "normal",
              "severity": "INFO"
            },
            "ResultPath": "$.classification",
            "Next": "RouteByClassification"
          },
          "RouteByClassification": {
            "Type": "Choice",
            "Comment": "Dirige la línea a SecurityAlerts si es sospechosa, a Logs si es normal",
            "Choices": [
              {
                "Variable": "$.classification.label",
                "StringEquals": "suspicious",
                "Next": "WriteSecurityAlert"
              }
            ],
            "Default": "WriteLog"
          },
          "WriteSecurityAlert": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${SECURITY_ALERTS_TABLE_NAME}",
              "Item": {
                "pk": {
                  "S.$": "$.pk"
                },
                "sk": {
                  "S.$": "$.sk"
                },
                "event_type": {
                  "S.$": "$.event_type"
                },
                "severity": {
                  "S.$": "$.classification.severity"
                },
                "ingested_at": {
                  "S.$": "$.ingested_at"
                },
                "last_modified": {
                  "S.$": "$.last_modified"
                },
                "hostname": {
                  "S.$": "$.hostname"
                },
                "program": {
                  "S.$": "$.program"
                },
                "pid": {
                  "S.$": "$.pid"
                },
                "src_ip": {
                  "S.$": "$.src_ip"
                },
                "syslog_timestamp": {
                  "S.$": "$.syslog_timestamp"
                },
                "message": {
                  "S.$": "$.message"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException",
                  "DynamoDB.RequestLimitExceededException",
                  "DynamoDB.AmazonDynamoDBException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 5,
                "BackoffRate": 2.0,
                "JitterStrategy": "FULL"
              }
            ],
            "End": true
          },
          "WriteLog": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${LOGS_TABLE_NAME}",
              "Item": {
                "pk": {
                  "S.$": "$.pk"
                },
                "sk": {
                  "S.$": "$.sk"
                },
                "gsi_pk": {
                  "S": "LOG"
                },
                "last_modified": {
                  "S.$": "$.last_modified"
                },
                "event_type": {
                  "S.$": "$.event_type"
                },
                "ingested_at": {
                  "S.$": "$.ingested_at"
                },
                "hostname": {
                  "S.$": "$.hostname"
                },
                "program": {
                  "S.$": "$.program"
                },
                "pid": {
                  "S.$": "$.pid"
                },
                "src_ip": {
                  "S.$": "$.src_ip"
                },
                "syslog_timestamp": {
                  "S.$": "$.syslog_timestamp"
                },
                "message": {
                  "S.$": "$.message"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException",
                  "DynamoDB.RequestLimitExceededException",
                  "DynamoDB.AmazonDynamoDBException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 5,
                "BackoffRate": 2.0,
                "JitterStrategy": "FULL"
              }
            ],
            "End": true
          }
        }
      },
      "End": true
    }
  }
}
